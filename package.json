{
  "name": "offline-speech",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Browser text-to-speech: a hosted offline app with resource controls, plus a standalone HTML build.",
  "scripts": {
    "download-model": "node scripts/download-assets.mjs --model",
    "build": "node scripts/build.mjs && node scripts/build-hosted.mjs",
    "test": "node --test",
    "test:unit": "node --test test/audio.test.mjs test/build.test.mjs test/download.test.mjs test/espeak.test.mjs test/unpack.test.mjs",
    "test:e2e": "node --test test/artifact.test.mjs test/e2e.test.mjs test/hosted.test.mjs",
    "download-libraries": "node scripts/download-assets.mjs --libraries",
    "download-assets": "node scripts/download-assets.mjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "build:standalone": "node scripts/build.mjs",
    "preview:hosted": "node scripts/serve-hosted.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "25.16.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later",
  "author": "Dima Korolev <dmitry.korolev@gmail.com>"
}
